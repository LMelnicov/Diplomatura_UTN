<div class="container" style="margin:100px 0">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Modificar el producto</h4>
            <form action="/admin/productos/modificar" method="post">

                <input type="hidden" value="{{producto.id}}" name="id">

                <div class="mb-3 row">
                    <label for="">Categoría</label>
                    <input type="text" class="form-control" name="categoria" value="{{producto.categoria}}">
                </div>

                <div class="mb-3 row">
                    <label for="">Título</label>
                    <input type="text" class="form-control" name="titulo" value="{{producto.titulo}}">
                </div>

                <div class="mb-3 row">
                    <label for="">Descripción</label>
                    <textarea name="descripcion" class="form-control">{{producto.descripcion}}</textarea>
                </div>

                <button type="submit" class="btn btn-primary">Modificar</button>
            </form>
            {{#if error}}
                <p>{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>
