<div class="container w-100">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">
            <h4>Agregar un nuevo producto</h4>
            <form action="/admin/productos/agregar" method="post">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Categoria" name="categoria">
                </div>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Titulo" name="titulo">
                </div>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Descripcion" name="descripcion">
                </div>
                <button class="btn btn-primary" type="submit">
                    Guardar
                </button>
            </form>

            {{#if error}}
            <p>{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>