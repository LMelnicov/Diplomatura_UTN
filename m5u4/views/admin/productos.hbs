<div class="container" style="margin-top: 50px;">
    <div class="row">
        <p class="text-end"> Hola {{usuario}}
            <a class="btn btn-danger" href="/admin/login/logout"> Cerrar Sesión
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </p>
    </div>

    <div class="mb-4">
        <a class="btn btn-success" href="/admin/productos/agregar">
            <i class="fa fa-plus" aria-hidden="true"></i> Nuevo
        </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">
        {{#each productos}}
        <div class="col">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h5 class="card-title">{{titulo}}</h5>
                    <p class="card-text">{{descripcion}}</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <div class="d-flex justify-content-center gap-2">
                        <a class="btn btn-primary btn-sm" href="/admin/productos/modificar/{{id}}">
                            <i class="fa fa-pencil"></i> Editar
                        </a>
                        <a class="btn btn-danger btn-sm" href="/admin/productos/eliminar/{{id}}">
                            <i class="fa fa-trash"></i> Eliminar
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>